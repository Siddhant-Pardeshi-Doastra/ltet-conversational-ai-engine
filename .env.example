# LTET Conversational AI Engine - environment template (placeholders only; never commit real values)
# Copy to .env for local runs. In DEMO mode everything works without external credentials.

# demo | live  (live mode with missing integration config FAILS readiness; never silently falls back to synthetic data)
LTET_MODE=demo

# HTTP
PORT=8787
HOST=127.0.0.1

# Secret used to sign staff session cookies (REQUIRED in live mode; set a long random value)
SESSION_SECRET=change-me-to-a-long-random-value

# Telephony webhook HMAC secret (REQUIRED in live mode; demo simulator does not need it)
TELEPHONY_WEBHOOK_SECRET=

# Live integration endpoints (leave empty in demo; readiness reports NOT_CONFIGURED)
IDENTITY_API_URL=
PORTAL_CLAIMS_API_URL=
FINANCE_API_URL=
OTP_PROVIDER_URL=

# Optional live speech providers (IR-11/12/13). Empty = deterministic no-key adapters used.
ASR_PROVIDER_URL=
TTS_PROVIDER_URL=
LLM_PROVIDER_URL=

# Audio recording of calls (SEC-07: default OFF pending approved consent/storage policy)
ENABLE_CALL_RECORDINGS=false

# Timezone for all team-facing times
TZ_DISPLAY=Asia/Kolkata
